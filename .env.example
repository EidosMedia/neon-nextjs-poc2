BASE_NEON_FO_URL=https://<your-neon-frontend-url>
NEON_APP_URL=https://<your-neonapp-url>
NEON_FRONTOFFICE_SERVICE_KEY=<your-neon-api-key>
DEV_FORCE_SITE=<site-name-to-force-on-localhost>
# Site configuration secrets (e.g. invalidateNextJsHeaderValue) are stripped from site and page data
# before rendering. Set to true ONLY to debug: the secrets then appear in page source.
NEON_EXPOSE_SITE_CONFIG_SECRETS=false
# Optional: comma-separated staticAttributes keys to strip (`prefix*` allowed); replaces the default
# (invalidateNextJsHeaderName,invalidateNextJsHeaderValue).
NEON_REDACTED_SITE_CONFIG_KEYS=
